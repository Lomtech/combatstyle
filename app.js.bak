function pad2(n) {
  return String(n).padStart(2, "0");
}

const CARD_ORDER = [
  "PBP",
  "WTC",
  "PPF",
  "DN",
  "FHF",
  "RBTS",
  "TSO",
  "DOGR",
  "WUGP",
  "LIH",
  "LTC",
  "TC",
];

function assignCardImages() {
  CARD_ORDER.forEach((id, idx) => {
    const a = archetypeById(id);
    if (a) a.img = `./images/archetyp_${pad2(idx + 1)}.jpg`;
  });
}

